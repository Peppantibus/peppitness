{
  "name": "peppitness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "setup:pwa": "npm install --save-dev vite-plugin-pwa",
    "build:pwa": "npm run typecheck && vite build --config vite.pwa.config.mjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
