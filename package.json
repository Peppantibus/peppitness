{
  "name": "peppitness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:auth:browser": "node scripts/auth-browser-check.mjs",
    "test:mfa:browser": "node scripts/mfa-gate-browser-check.mjs",
    "test:settings:browser": "node scripts/settings-browser-check.mjs",
    "test:exercises:groups:browser": "node scripts/muscle-groups-browser-check.mjs",
    "test:exercises:groups:local": "node --experimental-strip-types scripts/muscle-groups-api-local-check.mjs",
    "test:meal-energy:local": "node --experimental-strip-types scripts/meal-energy-api-local-check.mjs",
    "test:exercises:browser": "node scripts/exercises-browser-check.mjs",
    "test:programs:browser": "node scripts/programs-browser-check.mjs",
    "test:diary:browser": "node scripts/diary-browser-check.mjs",
    "test:wizard:browser": "node scripts/wizard-browser-check.mjs",
    "test:pwa:browser": "node scripts/pwa-browser-check.mjs",
    "test:mfa:local": "node --experimental-strip-types scripts/mfa-api-local-check.mjs",
    "test:api:local": "node --experimental-strip-types scripts/test-supabase-api.mjs",
    "test:infra": "node --test tests/local-supabase.test.mjs",
    "test:import:structured": "node --experimental-strip-types --test tests/import-structured.test.ts",
    "test:import:structured:browser": "node --experimental-strip-types scripts/import-structured-browser-check.mjs",
    "test:import:structured:local": "node --experimental-strip-types scripts/import-structured-local-check.mjs",
    "templates:import": "node --experimental-strip-types scripts/generate-structured-templates.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "backup:cloud": "node scripts/backup-cloud.mjs",
    "backup:restore-check": "node scripts/restore-check.mjs",
    "verify:release": "npm audit --audit-level=high && npm test && npm run test:infra && npm run build:pwa",
    "build:pwa": "npm run typecheck && vite build --config vite.pwa.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "supabase": "2.118.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
}
