      {"id": "pdf:2:b:1", "kind": "heading", "text": "Piano alimentare – giorno tipo", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": [], "page": 2, "origin": "native", "bbox": [0.0941,0.0347,0.3855,0.019]},
      {"id": "pdf:2:b:2", "kind": "paragraph", "text": "Colazione: yogurt greco 170 g con\navena 40 g e frutti di bosco 100 g.\nSpuntino: una mela e 15 g di noci.\nPranzo: riso basmati 80 g, pollo\n150 g e verdure a volontà.", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["pdf:2:b:1"], "page": 2, "origin": "native", "bbox": [0.0941,0.0869,0.2816,0.0796]},
      {"id": "pdf:2:b:3", "kind": "paragraph", "text": "Merenda: 2 fette di pane integrale\ncon 30 g di bresaola.\nCena: salmone 150 g, patate\n200 g e insalata con 10 g di olio.", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["pdf:2:b:1"], "page": 2, "origin": "native", "bbox": [0.521,0.0952,0.2764,0.0736]},
      {"id": "pdf:2:b:4", "kind": "paragraph", "text": "Bere almeno 2 litri di acqua al giorno, distribuiti fra i pasti principali.", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["pdf:2:b:1"], "page": 2, "origin": "native", "bbox": [0.0941,0.2295,0.5466,0.0131]}
