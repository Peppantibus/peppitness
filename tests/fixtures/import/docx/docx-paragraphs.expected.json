      {"id": "p:11", "kind": "paragraph", "text": "Aggiornata al 28/09/2026", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["p:1", "p:4", "p:10"], "page": null, "origin": "native", "bbox": null},
      {"id": "p:12", "kind": "paragraph", "text": "Recupero tra le serie: 90 secondi per tutti gli esercizi.", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["p:1", "p:4", "p:10"], "page": null, "origin": "native", "bbox": null},
      {"id": "p:13", "kind": "paragraph", "text": "Rest-pause sull’ultima serie; completa il set.", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["p:1", "p:4", "p:10"], "page": null, "origin": "native", "bbox": null},
      {"id": "p:14", "kind": "paragraph", "text": "Durata: 45 minuti", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["p:1", "p:4", "p:10"], "page": null, "origin": "native", "bbox": null},
      {"id": "p:15", "kind": "paragraph", "text": "Carico: ½ del massimale, 1′30″ di pausa — «tempo 3-1-1»", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["p:1", "p:4", "p:10"], "page": null, "origin": "native", "bbox": null},
