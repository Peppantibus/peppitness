      {"id": "p:7", "kind": "list_item", "text": "Bilanciere all’altezza delle spalle", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": "p:5", "headingIds": ["p:1", "p:4"], "page": null, "origin": "native", "bbox": null},
      {"id": "p:8", "kind": "list_item", "text": "Panca piana: 3 x 10–12", "tableId": null, "row": null, "column": null, "rowSpan": null, "columnSpan": null, "parentId": null, "headingIds": ["p:1", "p:4"], "page": null, "origin": "native", "bbox": null},
